# Symmetry Lite — example environment variables.
# Copy this file to .env before running docker-compose.

POSTGRES_DB=symmetry_lite
POSTGRES_USER=symmetry_lite
POSTGRES_PASSWORD=symmetry_lite
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=insecure-dev-key-replace-for-anything-real
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
